# Copy to `.env.local` and fill in real values. Never commit `.env.local`.
# All variables are validated at startup by `env.ts`; a missing or malformed
# required value stops the build/dev server with a message naming the variable.

# ── Client (exposed to the browser, must be prefixed NEXT_PUBLIC_) ────────────

# Absolute base URL of the site. Used for metadata / OpenGraph absolute URLs.
# Required.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Server (never sent to the browser) ──────────────────────────────────────

# Resend API key for sending contact-form emails. Required.
# Get one at https://resend.com — the free tier is enough for a portfolio.
RESEND_API_KEY=

# Address that contact-form submissions are delivered to AND sent from, so its
# domain must be verified in Resend (or use your Resend account email with the
# built-in onboarding sender). Required.
CONTACT_TO_EMAIL=

# Max contact-form submissions allowed per IP per hour. Optional (defaults to 5
# in lib/contact.ts).
CONTACT_RATE_LIMIT=

# ── Build ───────────────────────────────────────────────────────────────────

# Set to any value to skip env validation (e.g. container image builds that
# inject real env only at deploy time). Leave unset locally.
# SKIP_ENV_VALIDATION=
