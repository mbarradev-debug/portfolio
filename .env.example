# Copy to `.env.local` and fill in real values. Never commit `.env.local`.
# All variables are validated at startup by `env.ts`; a missing or malformed
# required value stops the build/dev server with a message naming the variable.

# ── Client (exposed to the browser, must be prefixed NEXT_PUBLIC_) ────────────

# Absolute base URL of the site. Used for metadata / OpenGraph absolute URLs.
# Required.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Server (never sent to the browser) ──────────────────────────────────────
# Currently optional — the contact form (PMB-015) will make them required.

# Resend API key for sending contact-form emails.
RESEND_API_KEY=

# Destination address that contact-form submissions are delivered to.
CONTACT_TO_EMAIL=

# Max contact-form submissions allowed per IP per hour. Optional (defaults are
# applied in code).
CONTACT_RATE_LIMIT=

# ── Build ───────────────────────────────────────────────────────────────────

# Set to any value to skip env validation (e.g. container image builds that
# inject real env only at deploy time). Leave unset locally.
# SKIP_ENV_VALIDATION=
